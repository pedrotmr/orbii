{
  "expo": {
    "name": "Orbii",
    "slug": "orbii",
    "scheme": "orbii",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.orbii.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FA",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "app.orbii.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F7FA",
          "dark": {
            "backgroundColor": "#181B18"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
