{
  "expo": {
    "name": "Orbii",
    "slug": "orbii",
    "scheme": "orbii",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.orbii.mobile.dev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FA",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "app.orbii.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F7FA",
          "dark": {
            "backgroundColor": "#181B18"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-widgets"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/cebd63af-63fc-4c5a-a302-dbae0bdcd6e8"
    }
  }
}
