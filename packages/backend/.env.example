# Deployment used by `npx convex dev` (CLI only — auto-populated by `convex deployment select` / `convex dev`)
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
# Clerk JWT issuer (Frontend API URL). Required on the Convex deployment
# (`npx convex env set` / dashboard). Mirror here in packages/backend/.env.local
# only if you keep a local copy — `convex env set` does not write this file:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# Clerk Backend API secret key used to verify OAuth access tokens and revoke grants.
CLERK_SECRET_KEY=
# Base64url-encoded 32-byte key used to encrypt stored opaque OAuth credentials.
MCP_CREDENTIAL_ENCRYPTION_KEY=
